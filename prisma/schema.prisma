// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Status of a storage job through the processing pipeline
enum storageStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Type of uploaded content — determines validation rules, bucket, and processing
enum fileType {
  IMAGE
  FILE
}

/// A registered user of the platform
model user {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String?
  name         String?
  password     String? // nullable — GitHub OAuth users have no password
  folders      folder[]
  shared_by_me   shared_file[] @relation("SharedBy")
  shared_with_me shared_file[] @relation("SharedWith")
  accounts     account[]
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now())
  storages     storage[]
}

/// OAuth / provider account linked to a user (used by NextAuth)
model account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// User-created folder for organising files, like Dropbox folders
model folder {
  id        String   @id @default(uuid())
  name      String
  parent_id String?
  parent    folder?  @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children  folder[] @relation("FolderHierarchy")

  userId   String
  user     user      @relation(fields: [userId], references: [id])
  files    file[]
  storages storage[] @relation("FolderStorage")

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

/// Storage model — tracks every upload through the processing pipeline.
/// Each record represents a single uploaded file with its processing state.
model storage {
  id            String        @id @default(uuid())
  file_type     fileType      @default(FILE)
  status        storageStatus @default(PENDING)
  original_url  String
  processed_url String?
  file_name     String
  user_id       String?
  folder_id     String?
  file_size     Int
  mime_type     String
  created_at    DateTime      @default(now())
  updated_at    DateTime      @default(now())
  chunks        chunk[]
  shared_files  shared_file[]
  user          user?         @relation(fields: [user_id], references: [id])
  folder        folder?       @relation("FolderStorage", fields: [folder_id], references: [id])
}

/// Represents a publicly-accessible shareable link for a storage record.
/// Anyone with the token URL can access the file without logging in.
model shared_file {
  token      String    @id
  storage_id String
  storage    storage   @relation(fields: [storage_id], references: [id])
  shared_by  String
  owner      user      @relation(fields: [shared_by], references: [id], name: "SharedBy")
  shared_with_id String?
  shared_with    user?     @relation(fields: [shared_with_id], references: [id], name: "SharedWith")
  expires_at DateTime?
  created_at DateTime  @default(now())
}

/// File model — stores metadata for large files uploaded via chunked upload.
/// Each file is split into fixed-size chunks stored individually in object storage (MinIO).
/// This model holds the reassembly metadata needed to reconstruct the original file.
model file {
  id          String   @id @default(uuid())
  file_name   String
  file_size   BigInt
  total_chunk Int
  created_at  DateTime @default(now())
  folderId    String?
  folder      folder?  @relation(fields: [folderId], references: [id])
  chunks      chunk[]
}

/// Chunk model — represents a single chunk of a file stored in object storage.
/// Chunks are created during chunked upload and contain integrity metadata (checksum).
model chunk {
  id          String @id @default(uuid())
  file_id     String
  chunk_index Int
  chunk_size  Int
  checkSum    String
  storage_id  String

  file    file    @relation(fields: [file_id], references: [id])
  storage storage @relation(fields: [storage_id], references: [id])
}
