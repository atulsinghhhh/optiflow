# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- frontend (Next.js) ---
frontend/node_modules
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

frontend/coverage
frontend/.next/
frontend/out/
frontend/build
frontend/app/generated/prisma

# --- backend (Go) ---
backend/bin/
backend/*.exe

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
