# --- NextAuth ---
AUTH_SECRET="change-me-generate-a-random-value"
NEXTAUTH_SECRET="change-me-generate-a-random-value"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# GitHub OAuth provider is currently disabled in lib/auth.ts — auth-svc has no
# OAuth exchange endpoint yet. These are unused until it's added back.
GITHUB_ID=""
GITHUB_SECRET=""

# --- Go backend services ---
# credentials sign-in/sign-up call auth-svc directly instead of Prisma.
# Run each via `go run ./cmd/<svc>` (from /backend); default ports below.
NEXT_PUBLIC_AUTH_SVC_URL="http://localhost:8081"
NEXT_PUBLIC_API_SVC_URL="http://localhost:8082"
NEXT_PUBLIC_UPLOAD_SVC_URL="http://localhost:8083"
NEXT_PUBLIC_NOTIFY_SVC_URL="http://localhost:8084"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV=development
